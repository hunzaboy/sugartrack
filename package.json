{
  "name": "sugartrack",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/datetimepicker": "9.1.0",
    "expo": "~57.0.15",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.10",
    "expo-dev-client": "~57.0.14",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image-picker": "~57.0.12",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.7",
    "expo-notifications": "~57.0.13",
    "expo-print": "~57.0.1",
    "expo-router": "~57.0.15",
    "expo-sharing": "~57.0.14",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-gifted-charts": "^1.4.78",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-zip-archive": "^9.0.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "expo-mcp": "~0.2.4",
    "sharp": "^0.35.3",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "assets:brand": "node scripts/generate-brand-assets.mjs",
    "assets:screenshots": "node scripts/generate-store-screenshots.mjs",
    "build:dev": "eas build --profile development --platform android",
    "build:preview": "eas build --profile preview --platform android",
    "build:production": "eas build --profile production --platform android",
    "submit:android": "eas submit --platform android --profile production",
    "build:submit:android": "eas build --platform android --profile production --auto-submit",
    "check:contrast": "node scripts/check-contrast.mjs",
    "verify": "npm run typecheck && npm test && npm run check:contrast",
    "assets:feature": "node scripts/generate-feature-graphic.mjs",
    "assets:all": "npm run assets:brand && npm run assets:feature"
  },
  "private": true,
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
